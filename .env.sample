# Google Analytics Configuration
# Add your GA Measurement ID (e.g. G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=

# Toggle tracking globally (true/false, default: true if measurement ID is present)
PUBLIC_GA_ENABLED=true

# Plausible Analytics Configuration (Cookie-less)
# Add your Plausible Domain name (e.g. example.com)
PUBLIC_PLAUSIBLE_DOMAIN=
# Toggle Plausible tracking globally (true/false, default: true)
PUBLIC_PLAUSIBLE_ENABLED=true
# Plausible script URL (custom domain if using a proxy, otherwise default)
PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
