---
import { getCollection, render, type CollectionEntry } from "astro:content";
import LegalPageLayout from "../../../components/layouts/LegalPageLayout.astro";
import { fetchSiteData } from "../../../services/api";
import * as contentUtils from "../../../services/contentUtils";

export async function getStaticPaths() {
    if (process.env.BUILD_MODE !== "static") return [];
    const allLegalPosts = await getCollection("legal");
    try {
        const fs = await import("node:fs/promises");
        const path = await import("node:path");
        const dataDir = path.resolve(process.cwd(), "src/data/static");
        const manifest = JSON.parse(await fs.readFile(path.join(dataDir, "manifest.json"), "utf-8"));
        const paths: any[] = [];
        for (const concept of manifest.concepts) {
            const siteData = JSON.parse(await fs.readFile(path.join(dataDir, concept.dataFile), "utf-8"));
            const conceptSlug = concept.slug ? concept.slug.replace(/^\/+|\/+$/g, "") : "default";
            const conceptPosts = allLegalPosts.filter(post => post.data.conceptSlug === conceptSlug || post.id.startsWith(`${conceptSlug}/`) || (conceptSlug === 'default' && !post.id.includes('/')));
            for (const post of conceptPosts) {
                if (concept.slug) {
                    paths.push({ params: { slug: conceptSlug, post: contentUtils.stripConceptPrefix(post.id) }, props: { entry: post, conceptSlug, site: siteData } });
                }
            }
        }
        return paths;
    } catch (e) {
        console.warn("Static build: manifest not found, using fallback", e);
        return [];
    }
}

const { slug, post } = Astro.params;
const { entry: propEntry, conceptSlug: propConceptSlug, site: propSite } = Astro.props;

let entry: CollectionEntry<"legal"> = propEntry;
let conceptSlug = propConceptSlug || slug || "default";
let site = propSite;

if (!entry || !site) {
    try {
        const allPosts = await getCollection("legal");
        const conceptPrefix = conceptSlug === "default" ? "default/" : `${conceptSlug}/`;
        entry = allPosts.find(p => p.id === `${conceptPrefix}${post}`) || allPosts.find(p => p.id === post) || allPosts.find(p => contentUtils.stripConceptPrefix(p.id) === post)!;
        if (!entry) {
            const base = import.meta.env.BASE_URL.replace(/\/$/, "");
            let target404 = slug ? `/${slug}/404-page` : "/404-page";
            if (base && !target404.startsWith(base)) {
                target404 = base + target404;
            }
            return Astro.redirect(target404);
        }
        site = await fetchSiteData(slug ? `slug:${slug}` : undefined);
        conceptSlug = slug || "default";
    } catch (error) {
        const base = import.meta.env.BASE_URL.replace(/\/$/, "");
        let target404 = slug ? `/${slug}/404-page` : "/404-page";
        if (base && !target404.startsWith(base)) {
            target404 = base + target404;
        }
        return Astro.redirect(target404);
    }
}

const { Content } = await render(entry);
const readingTime = contentUtils.calculateReadingTime(entry.body || "");
const backUrl = import.meta.env.BASE_URL;


const forcedMode = Astro.url.searchParams.get("mode");
---

<LegalPageLayout
    entry={entry}
    site={site}
    forcedMode={forcedMode}
    readingTime={readingTime}
    backUrl={backUrl}
    backLabel="Back to Home"
    conceptSlug={conceptSlug}
    pageIdPrefix="legal-page"
>
    <Content />
</LegalPageLayout>
