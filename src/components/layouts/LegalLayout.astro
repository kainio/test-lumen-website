---
// Blog Layout Component for rendering individual blog posts
import "../../index.css";

interface Props {
    title: string;
    description: string;
    pubDate: Date;
    image?: string;
    category?: string;
}

const { title, description, pubDate, image, category } = Astro.props;

const formattedDate = pubDate.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
});
---

<article class="blog-post">
    <!-- Featured Image -->
    {
        image && (
            <div class="blog-post-hero mb-8 md:mb-12">
                <img
                    src={image}
                    alt={title}
                    class="w-full h-[300px] md:h-[400px] lg:h-[500px] object-cover rounded-xl"
                />
            </div>
        )
    }

    <!-- Post Header -->
    <header class="blog-post-header mb-8 md:mb-12 max-w-4xl mx-auto">
        <!-- Category Badge -->
        {
            category && (
                <div class="mb-4">
                    <span class="inline-block bg-primary/10 text-primary px-4 py-1.5 rounded-full text-sm font-semibold">
                        {category}
                    </span>
                </div>
            )
        }

        <!-- Title -->
        <h1
            class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight"
        >
            {title}
        </h1>

        <!-- Description -->
        <p
            class="text-xl md:text-2xl text-foreground opacity-70 dark:opacity-80 mb-6"
        >
            {description}
        </p>
    </header>

    <!-- Post Content -->
    <div
        class="blog-post-content prose prose-lg dark:prose-invert max-w-4xl mx-auto"
    >
        <slot />
    </div>
</article>

<style>
    .blog-post {
        padding: 2rem 1rem;
    }

    @media (min-width: 768px) {
        .blog-post {
            padding: 3rem 2rem;
        }
    }

    .prose {
        color: var(--color-text-primary);
    }

    .prose :global(h2),
    .prose :global(h3),
    .prose :global(h4) {
        font-weight: 700;
        margin-top: 2em;
        margin-bottom: 0.75em;
    }

    .prose :global(h2) {
        font-size: 2em;
    }

    .prose :global(h3) {
        font-size: 1.5em;
    }

    .prose :global(p) {
        margin-bottom: 1.25em;
        line-height: 1.75;
    }

    .prose :global(ul),
    .prose :global(ol) {
        margin-bottom: 1.25em;
        padding-left: 1.5em;
    }

    .prose :global(li) {
        margin-bottom: 0.5em;
    }

    .prose :global(blockquote) {
        border-left: 4px solid var(--color-primary);
        padding-left: 1.5em;
        margin: 1.5em 0;
        font-style: italic;
        color: var(--color-text-primary);
        opacity: 0.9;
    }

    .prose :global(code) {
        background: var(--color-surface-container-high);
        padding: 0.25em 0.5em;
        border-radius: 0.25em;
        font-size: 0.9em;
    }

    .prose :global(pre) {
        background: var(--color-surface-container-high);
        padding: 1.5em;
        border-radius: 0.5em;
        overflow-x: auto;
        margin: 1.5em 0;
    }

    .prose :global(pre code) {
        background: none;
        padding: 0;
    }

    .prose :global(img) {
        border-radius: 0.5em;
        margin: 2em 0;
    }

    .prose :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 2em 0;
    }

    .prose :global(th),
    .prose :global(td) {
        border: 1px solid var(--color-outline-variant);
        padding: 0.75em;
        text-align: left;
    }

    .prose :global(th) {
        background: var(--color-surface-container-low);
        font-weight: 600;
    }

    .prose :global(a) {
        color: var(--color-primary);
        text-decoration: none;
        border-bottom: 1px solid var(--color-primary);
        transition: opacity 0.2s;
    }

    .prose :global(a:hover) {
        opacity: 0.7;
    }

    .prose :global(hr) {
        border: none;
        border-top: 1px solid var(--color-outline-variant);
        margin: 3em 0;
    }
</style>
